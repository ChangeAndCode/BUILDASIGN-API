# .env

PORT=3000

# MongoDB
MONGO_URI=mongodb+srv://<tu_usuario>:<tu_contraseña>@<tu_cluster>.mongodb.net/<tu_nombre_db>?retryWrites=true&w=majority

# Sesiones de Express
SESSION_SECRET=UNA_CLAVE_SECRETA_LARGA_Y_ALEATORIA_MUY_SEGURA

# Google OAuth
GOOGLE_CLIENT_ID=TU_CLIENT_ID_DE_GOOGLE
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET_DE_GOOGLE
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Importacion de archivos madre grandes
MASTER_FILE_MAX_SIZE_MB=200
MASTER_IMPORT_BATCH_SIZE=500
MASTER_IMPORT_CONCURRENCY=1
MASTER_IMPORT_WARNING_SAMPLE_LIMIT=200
MASTER_IMPORT_TEMP_DIR=./temp_master_imports
#JWT 
JWT_SECRET=UNA_CLAVE_SECRETA_LARGA_Y_ALEATORIA_MUY_SEGURA
# SFTP Local 01 (usa password o llave privada)
SFTP_HOST=your_local_01_sftp_host.com
SFTP_PORT=22
SFTP_USERNAME=your_local_01_sftp_username
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_REMOTE_UPLOAD_DIR=/path/on/local-01/for/uploads
SFTP_REMOTE_ERROR_DIR=/path/on/local-01/for/errors
SFTP_NAME_CONFLICT_STRATEGY=overwrite
SFTP_MAX_CONNECTION_ATTEMPTS=2

# SFTP Local 02 (usa password o llave privada)
SFTP_2_HOST=your_local_02_sftp_host.com
SFTP_2_PORT=22
SFTP_2_USERNAME=your_local_02_sftp_username
SFTP_2_PASSWORD=
SFTP_2_PRIVATE_KEY_PATH=
SFTP_2_PRIVATE_KEY_PASSPHRASE=
SFTP_2_REMOTE_UPLOAD_DIR=/path/on/local-02/for/uploads
SFTP_2_REMOTE_ERROR_DIR=/path/on/local-02/for/errors
SFTP_2_NAME_CONFLICT_STRATEGY=overwrite
SFTP_2_MAX_CONNECTION_ATTEMPTS=2

# Un envio pending/sending puede recuperarse despues de este tiempo
SFTP_LOCK_TIMEOUT_MS=900000

# Sede usada por el procesador automatizado: local-01 o local-02
SFTP_AUTOMATED_SITE=local-01

##CRON
SFTP_LOCAL_INPUT_DIR=./sftp_input_watch
SFTP_LOCAL_PROCESSED_DIR=./sftp_processed
SFTP_LOCAL_FAILED_DIR=./sftp_failed
AUTOMATED_FILE_PROCESSOR_CRON_SCHEDULE='*/5 * * * *' # Runs every 5 minutes
